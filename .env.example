# Environment Mode: sit | uat | prod
APP_ENV=sit

# Logging Toggles (optional; defaults to true in sit/uat and false in prod)
ENABLE_API_LOG=true
ENABLE_IPC_LOG=true

# MCP Registry API Configuration
MCP_REGISTRY_BASE_URL=https://registry.modelcontextprotocol.io
MCP_REGISTRY_API_VERSION=v0.1

# C-CodeX Backend API Configuration
BACKEND_HOST=

# Auto-Updater Feed Configuration
UPDATE_FEED_URL=https://updates.ccodex.com/releases

# Logging (PROD dafault off)
APP_ENV=sit
ENABLE_API_LOG=true
ENABLE_IPC_LOG=true