{
  "name": "desktop-app",
  "version": "1.0.0",
  "description": "C-CodeX Desktop Application",
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "sass": "^1.107.1",
    "typescript": "^7.0.2",
    "undici-types": "^8.12.4",
    "vite": "^8.3.5"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev --entry ./out/main/index.js",
    "build": "electron-vite build",
    "build:win": "electron-vite build && node --use-system-ca ./node_modules/electron-builder/cli.js --win",
    "build:mac": "electron-vite build && node --use-system-ca ./node_modules/electron-builder/cli.js --mac",
    "preview": "electron-vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@vscode/ripgrep": "^1.18.0",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
